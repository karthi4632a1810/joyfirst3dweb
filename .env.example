# ─────────────────────────────────────────────────────────────────────────────
# JOYFIRST — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for development, and set the same keys in the
# Vercel project settings for production. `.env.local` is git-ignored.
#
# The site runs with NONE of these set — every one enables an optional feature.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site origin. Used for metadata, canonical URLs, sitemap and JSON-LD.
# Defaults to https://joyfirst.in when unset.
NEXT_PUBLIC_SITE_URL=https://joyfirst.in

# ── Contact form delivery ────────────────────────────────────────────────────
# Where a validated enquiry is POSTed as JSON. Any endpoint that accepts a JSON
# body works: a Zapier/Make webhook, a Slack incoming webhook, a CRM endpoint,
# or your own /api route that sends mail.
#
# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship it to the
# browser. When unset, enquiries are logged on the server and the visitor still
# gets a success state.
CONTACT_WEBHOOK_URL=

# ── Sanity CMS (optional, not yet wired) ─────────────────────────────────────
# Set these once a Studio exists, then swap the function bodies in
# src/lib/content.ts from local data to sanityClient.fetch().
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token for draft/preview content. Server-only.
SANITY_API_READ_TOKEN=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
